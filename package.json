{
  "name": "surfwarden",
  "version": "0.1.0",
  "description": "本地优先的网页时间统计与监督插件：分用途记录，而不是域名一刀切。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
