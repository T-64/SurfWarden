{
  "name": "surfwarden",
  "version": "0.3.0",
  "description": "本地优先的网页时间统计与监督插件：分用途记录，而不是域名一刀切。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include='src/core/**' --coverage.include='src/shared/**'",
    "smoke": "node e2e/smoke.mjs",
    "e2e:block": "node e2e/blocking.mjs",
    "e2e:options": "node e2e/options.mjs",
    "check:privacy": "node scripts/check-no-net.mjs",
    "shots": "node e2e/shoot.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  }
}
